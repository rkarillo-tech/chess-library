// Configuración para publicar la app en Cloudflare Workers.
// Cloudflare ejecuta primero el comando de compilación (node scripts/build.js), que prepara dist/,
// y después «npx wrangler deploy», que publica esa carpeta detrás de src/worker.js
// (usuario y contraseña; se configuran en Settings → Variables and Secrets: APP_USER y APP_PASSWORD).
{
  "name": "chess-library",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // Conserva las variables definidas en el panel de Cloudflare en cada publicación
  "keep_vars": true
}
